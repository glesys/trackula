{
    "name": "glesys/trackula",
    "description": "Offline carrier detection for parcel tracking numbers, Nordic carriers first.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "tracking number",
        "carrier",
        "parcel",
        "postnord",
        "bring",
        "s10",
        "sscc"
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*"
    },
    "require-dev": {
        "carthage-software/mago": "^1.51",
        "pestphp/pest": "^3.0 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Glesys\\Trackula\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Glesys\\Trackula\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "format": "mago format",
        "lint": "mago lint",
        "analyze": "mago analyze",
        "check": [
            "mago format --check",
            "mago lint",
            "mago analyze",
            "pest"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
